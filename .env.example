# Public Web configuration
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_REGISTRY_V2_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet.monadexplorer.com

# Web server configuration
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
REGISTRY_V2_ADDRESS=0x0000000000000000000000000000000000000000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma-separated wallets allowed to read /operations. Leave empty to disable it.
OPERATOR_WALLET_ADDRESSES=0x0000000000000000000000000000000000000000

# Contract deployment (never expose these to Next.js)
DEPLOYER_PRIVATE_KEY=0x...
COORDINATOR_ADDRESS=0x...
WORKER_0_ADDRESS=0x...
WORKER_1_ADDRESS=0x...
WORKER_2_ADDRESS=0x...

# Agent Runner (server-only)
AI_API_KEY=replace-with-ai-api-key
AI_MODEL=replace-with-tool-calling-model
# AI_BASE_URL=https://api.openai.com/v1
# Optional model separation. Omit these to reuse AI_MODEL and AI_API_KEY.
# AI_DESIGN_MODEL=replace-with-design-model
# AI_EVALUATION_MODEL=replace-with-independent-evaluator-model
# AI_EVALUATION_API_KEY=replace-with-evaluator-api-key
# AI_EVALUATION_BASE_URL=https://api.openai.com/v1
# Configure this to enable semantic duplicate detection. Without it, the Runner
# uses deterministic character similarity so a hackathon demo remains self-contained.
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_API_KEY=replace-with-embedding-api-key
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# Total time allowed for one AI planning/generation tool loop (45s-600s).
AI_TOOL_TIMEOUT_MS=120000
COORDINATOR_PRIVATE_KEY=0x...
WORKER_0_PRIVATE_KEY=0x...
WORKER_1_PRIVATE_KEY=0x...
WORKER_2_PRIVATE_KEY=0x...
REWARD_TREASURY_PRIVATE_KEY=0x...
WORKER_REWARD_AMOUNT_MON=0.001
RUNNER_POLL_INTERVAL_MS=5000
