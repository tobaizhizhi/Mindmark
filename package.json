{
  "name": "mindmark",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "fixtures:demo": "node scripts/generate-demo-fixtures.mjs",
    "fixtures:vectors": "pnpm --filter @mindmark/shared generate:vectors",
    "fixtures:generate": "pnpm fixtures:demo && pnpm fixtures:vectors"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "24.10.9",
    "eslint": "9.39.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
