{
  "name": "mindmark",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "fixtures:demo": "node scripts/generate-demo-fixtures.mjs",
    "fixtures:generate": "pnpm fixtures:demo",
    "quality:replay": "tsx scripts/replay-ai-quality.ts",
    "quality:evaluator-live": "tsx --tsconfig apps/agent-runner/tsconfig.json --env-file-if-exists=.env scripts/replay-live-ai-quality.ts",
    "quality:live": "pnpm quality:evaluator-live",
    "quality:canary": "pnpm quality:replay && pnpm exec vitest run packages/shared/test/learning-design-v3.test.ts packages/shared/test/quality-corpus.test.ts apps/agent-runner/test/project-pipeline-v2.test.ts apps/agent-runner/test/quality-evaluator-v3.test.ts apps/agent-runner/test/embedding-v3.test.ts && pnpm quality:evaluator-live"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "24.10.9",
    "eslint": "9.39.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
