{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python3 -m compileall -q apps/ai-gateway/src"
  },
  "deploy": {
    "startCommand": "PYTHONPATH=apps/ai-gateway/src python3 -m mindmark_ai_gateway.app",
    "numReplicas": 1,
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
