{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @mindmark/shared build && pnpm --filter @mindmark/ai-gateway build && pnpm --filter @mindmark/web build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @mindmark/web start",
    "numReplicas": 1,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
